{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acmm.local/schema/contract-0.1.json",
  "title": "ACMM Experiment Contract v0.1",
  "description": "Machine-readable structural schema for ACMM Experiment Contract v0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "subjects",
    "requirements",
    "checks",
    "scenarios",
    "evidence_policy",
    "run_protocol"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidence_policy"
    },
    "run_protocol": {
      "$ref": "#/$defs/run_protocol"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agent",
        "model"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonempty_string"
            },
            "version": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonempty_string"
            },
            "provider": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "statement",
        "applicability",
        "compliance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "dimension": {
          "type": "string",
          "enum": [
            "goal_fit",
            "obligation",
            "boundary",
            "procedure",
            "feedback",
            "robustness"
          ]
        },
        "statement": {
          "$ref": "#/$defs/nonempty_string"
        },
        "applicability": {
          "$ref": "#/$defs/nonempty_string"
        },
        "compliance": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evaluator"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "evaluator": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task",
        "opportunities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt"
          ],
          "properties": {
            "prompt": {
              "$ref": "#/$defs/nonempty_string"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixture": {
              "$ref": "#/$defs/identifier"
            },
            "configuration": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "opportunities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/opportunity"
          }
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_id",
        "check_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "check_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture"
      ],
      "properties": {
        "capture": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "conversation",
              "tool_calls",
              "tool_results",
              "final_response",
              "initial_environment_state",
              "final_environment_state",
              "workspace_artifacts"
            ]
          }
        }
      }
    },
    "reset_state": {
      "type": "string",
      "enum": [
        "fresh",
        "baseline",
        "preserve"
      ]
    },
    "run_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "reset",
        "termination"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversation",
            "memory",
            "workspace",
            "environment"
          ],
          "properties": {
            "conversation": {
              "$ref": "#/$defs/reset_state"
            },
            "memory": {
              "$ref": "#/$defs/reset_state"
            },
            "workspace": {
              "$ref": "#/$defs/reset_state"
            },
            "environment": {
              "$ref": "#/$defs/reset_state"
            }
          }
        },
        "termination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "anyOf": [
            {
              "required": [
                "max_steps"
              ]
            },
            {
              "required": [
                "timeout_seconds"
              ]
            }
          ]
        }
      }
    }
  }
}
