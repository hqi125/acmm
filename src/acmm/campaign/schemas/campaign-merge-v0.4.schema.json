{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acmm.local/schemas/campaign-merge-v0.4.schema.json",
  "title": "ACMM Campaign Merge v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "merge",
    "population",
    "observations_artifact"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "campaign_id",
        "experiment_id",
        "created_at",
        "completeness",
        "allow_partial",
        "design_digest",
        "campaign_manifest_sha256",
        "contract_sha256",
        "package_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "allow_partial": {
          "type": "boolean"
        },
        "design_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "campaign_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "observed",
        "pending"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest",
        "manifest_sha256",
        "adjudicator_package_sha256",
        "adjudication_component_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adjudicator_package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adjudication_component_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observations_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "rows"
      ],
      "properties": {
        "path": {
          "const": "observations.jsonl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_run_id",
        "run_index",
        "subject_id",
        "scenario_id",
        "repetition",
        "source_execution_id",
        "source_execution_status",
        "source_attempt",
        "source_run_id",
        "source_campaign_execution",
        "source_campaign_execution_sha256",
        "source_event_journal_sha256",
        "source_result",
        "source_run_record_sha256",
        "merged_result",
        "merged_run_record_sha256"
      ],
      "properties": {
        "logical_run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_index": {
          "type": "integer",
          "minimum": 0
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "source_execution_id": {
          "type": "string",
          "minLength": 1
        },
        "source_execution_status": {
          "type": "string",
          "minLength": 1
        },
        "source_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_campaign_execution": {
          "type": "string",
          "minLength": 1
        },
        "source_result": {
          "type": "string",
          "minLength": 1
        },
        "source_run_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "merged_result": {
          "type": "string",
          "minLength": 1
        },
        "merged_run_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_campaign_execution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_event_journal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
