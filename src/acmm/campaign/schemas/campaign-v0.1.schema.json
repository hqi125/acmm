{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acmm.local/schemas/campaign-v0.1.schema.json",
  "title": "ACMM Campaign Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "package",
    "design",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "campaign": {
      "$ref": "#/$defs/campaign"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "experiment_id",
        "created_at",
        "design_digest",
        "run_count",
        "contract_artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "design_digest": {
          "$ref": "#/$defs/sha256"
        },
        "run_count": {
          "type": "integer",
          "minimum": 0
        },
        "contract_artifact": {
          "const": "contract.yaml"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sha256",
        "contract_sha256",
        "runtime_sha256",
        "snapshot_artifact",
        "integrations"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "snapshot_artifact": {
          "const": "package_store"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "scenarios",
        "run_protocol"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "run_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repetitions",
            "ordering",
            "scenario_ordering"
          ],
          "properties": {
            "repetitions": {
              "type": "integer",
              "minimum": 1
            },
            "ordering": {
              "type": "string",
              "minLength": 1
            },
            "scenario_ordering": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index",
        "run_id",
        "subject_id",
        "scenario_id",
        "repetition"
      ],
      "properties": {
        "run_index": {
          "type": "integer",
          "minimum": 0
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
