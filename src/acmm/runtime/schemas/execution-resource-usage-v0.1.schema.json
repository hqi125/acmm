{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acmm.local/schemas/execution-resource-usage-v0.1.schema.json",
  "title": "ACMM Execution Resource Usage v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution",
    "governor",
    "history_artifacts",
    "materializations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "experiment_id",
        "status",
        "selected_run_indices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "interrupted",
            "failed"
          ]
        },
        "selected_run_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "governor": {
      "type": "object"
    },
    "history_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "materializations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "selected_run_indices",
          "admission",
          "usage"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "selected_run_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "admission": {
            "type": "object"
          },
          "usage": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
