{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACMM Experiment Package Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "contract"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "root",
        "entrypoint"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "const": "0.1"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "apparatus": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplementary"
      ],
      "properties": {
        "supplementary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "configuration"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "configuration": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
