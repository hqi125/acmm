{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acmm.local/schemas/analysis-plan-v0.1.json",
  "title": "ACMM Analysis Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "population", "analyses"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {"enum": ["strict", "available-valid"]}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrap": {"$ref": "#/$defs/bootstrap"}
      }
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/analysis"}
    },
    "reports": {
      "type": "array",
      "items": {"$ref": "#/$defs/report"}
    }
  },
  "$defs": {
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicates": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "requirement_estimates"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "requirement_uncertainty"},
            "bootstrap": {"$ref": "#/$defs/bootstrap"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "dimension_scores"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "dimension_uncertainty"},
            "bootstrap": {"$ref": "#/$defs/bootstrap"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "availability"},
            "bootstrap": {"$ref": "#/$defs/bootstrap"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "design"],
          "properties": {
            "kind": {"const": "interaction"},
            "design": {"type": "string", "minLength": 1},
            "bootstrap": {"$ref": "#/$defs/bootstrap"}
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["compliance_workbook", "availability_workbook", "interaction_workbook"]
        }
      }
    }
  }
}
