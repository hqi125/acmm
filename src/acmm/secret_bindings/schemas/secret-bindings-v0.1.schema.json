{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:acmm:secret-bindings:0.1",
  "title": "ACMM Secret Bindings Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bindings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/integration_binding"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "file_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "file"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "integration_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_id", "integration_id", "secret_id", "source"],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/experiment_id"},
        "integration_id": {"$ref": "#/$defs/identifier"},
        "secret_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/file_source"}
      }
    }
  }
}
