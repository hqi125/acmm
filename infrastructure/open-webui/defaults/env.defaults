# ACMM Open WebUI deployment defaults.
# This file contains no provider credentials or other secrets.

OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4@sha256:9591b13f13843c7721c2b8eaf7382846c81b3ffe126526d1888d1fed50c6a33f
OPEN_WEBUI_CONTAINER_NAME=acmm-open-webui
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_OLLAMA_BASE_URL=http://host.docker.internal:11434
OPEN_WEBUI_AUTH=false
OPEN_WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key
OPEN_WEBUI_ENABLE_OLLAMA_API=true
OPEN_WEBUI_ENABLE_OPENAI_API=false
OPEN_WEBUI_ENABLE_PLUGINS=true
OPEN_WEBUI_ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false
OPEN_WEBUI_SCARF_NO_ANALYTICS=true
OPEN_WEBUI_DO_NOT_TRACK=true
OPEN_WEBUI_ANONYMIZED_TELEMETRY=false
OPEN_WEBUI_ENABLE_DIRECT_CONNECTIONS=false
OPEN_WEBUI_ENABLE_DIRECT_INTEGRATIONS=false
OPEN_WEBUI_ENABLE_WEB_SEARCH=false
OPEN_WEBUI_ENABLE_CODE_EXECUTION=false
OPEN_WEBUI_ENABLE_CODE_INTERPRETER=false
OPEN_WEBUI_ENABLE_MEMORIES=false
OPEN_WEBUI_ENABLE_MEMORY_SYSTEM_CONTEXT=false
OPEN_WEBUI_ENABLE_MEMORY_BACKGROUND_REVIEW=false
OPEN_WEBUI_ENABLE_IMAGE_GENERATION=false
OPEN_WEBUI_ENABLE_IMAGE_PROMPT_GENERATION=false
OPEN_WEBUI_ENABLE_TITLE_GENERATION=false
OPEN_WEBUI_ENABLE_TAGS_GENERATION=false
OPEN_WEBUI_ENABLE_FOLLOW_UP_GENERATION=false
OPEN_WEBUI_ENABLE_AUTOCOMPLETE_GENERATION=false
OPEN_WEBUI_ENABLE_SEARCH_QUERY_GENERATION=false
OPEN_WEBUI_ENABLE_RETRIEVAL_QUERY_GENERATION=false
OPEN_WEBUI_TOOL_SERVER_CONNECTIONS=[]
OPEN_WEBUI_TERMINAL_SERVER_CONNECTIONS=[]
